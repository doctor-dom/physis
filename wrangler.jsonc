{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physis",
  "compatibility_date": "2026-07-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "calc.dom.doctor",
      "custom_domain": true
    }
  ]
}
