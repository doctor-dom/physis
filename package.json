{
  "name": "physis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run import:data && vite",
    "build": "npm run import:data && tsc -b && vite build",
    "import:data": "node scripts/import-tw3-individual-stages.mjs && node scripts/import-clinical-data.mjs && node scripts/import-bp-data.mjs && node scripts/import-gonad-auxology-data.mjs",
    "import:kr": "node scripts/generate-khamis-roche-data.mjs",
    "test:cdc-calibration": "node scripts/test-cdc-chart-calibration.mjs",
    "test:cdc-landmark-plot": "node scripts/test-cdc-landmark-plot.mjs data/cdc/landmarks/cdc-landmarks-boys.json && node scripts/test-cdc-landmark-plot.mjs data/cdc/landmarks/cdc-landmarks-girls.json",
    "apply:cdc-landmarks": "node scripts/apply-cdc-landmarks.mjs",
    "bootstrap:cdc-landmarks-girls": "node scripts/bootstrap-cdc-landmarks.mjs",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=physis-calc"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "pngjs": "^7.0.0",
    "pdf-parse": "^2.4.5",
    "vite": "^6.0.0",
    "wrangler": "^4.111.0",
    "@cloudflare/workers-types": "^5.20260710.1"
  }
}
